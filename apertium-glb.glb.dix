<?xml version="1.0" encoding="UTF-8"?>
<dictionary>

  <!-- Define the alphabet below. -->
  <alphabet>aAáÁăảạÆbBcCčdDÐeEéèễệfFgGhHiIíjJkKlLmMnNoOóöớpPqQrRsSšştTŢuUúüưvVwWxXyYzZ</alphabet>

  <sdefs>
    <!-- Define symbol definitions within <sdef> here. -->
    <sdef n="n"               c="Noun"/>
    <sdef n="np"              c="Proper noun"/>
    <sdef n="vblex"           c="Verb, lexical"/>
    <sdef n="vbmod"           c="Modal verb"/>
    <sdef n="vaux"            c="Auxiliary verb"/>
    <sdef n="vbser"           c="'To be' verb"/>
    <sdef n="vbhaver"         c="'To have' verb"/>
    <sdef n="cnjsub"          c="Subordinating conjunction"/>
    <sdef n="cnjcoo"          c="Co-ordinating conjunction"/>
    <sdef n="cnjadv"          c="Adverbial conjunction"/>
    <sdef n="pr"              c="Preposition"/>
    <sdef n="vbpr"            c="Verbal Preposition"/>
    <sdef n="adv"             c="Adverb"/>
    <sdef n="ij"              c="Interjection"/>
    <sdef n="adj"             c="Adjective"/>
    <sdef n="prn"             c="Pronoun"/>
    <sdef n="pfx"             c="Pronoun"/>

    <sdef n="attr"            c="Attributive"/>
    <sdef n="top"             c="Toponym"/>
    <sdef n="ant"             c="Anthroponym"/>
    <sdef n="cog"             c="Cognomen"/>
    <sdef n="org"             c="Organisation"/>
    <sdef n="al"              c="Altres / misc proper nouns"/>

    <sdef n="pers"            c="Personal pronoun"/>
    <sdef n="ref"             c="Reflexive pronoun"/>
    <sdef n="res"             c="Reciprocal pronoun"/>

    <sdef n="det"             c="Determiner"/>
    <sdef n="pos"             c="Possessive"/>

    <sdef n="p1"              c="1st person"/>
    <sdef n="p2"              c="2nd person"/>
    <sdef n="p3"              c="3rd person"/>

    <sdef n="nt"              c="Neuter"/>
    <sdef n="ut"              c="Utrum"/>
    <sdef n="GD"              c="Gender to be determined"/>
    <sdef n="f"               c="Feminine"/>
    <sdef n="m"               c="Masculine"/>
    <sdef n="un"              c="No gender"/>

    <sdef n="sg"              c="Singular"/>
    <sdef n="du"              c="Dual"/>
    <sdef n="pl"              c="Plural"/>
    <sdef n="sp"              c="Singular / plural"/>

    <sdef n="ind"             c="Indefinite"/>
    <sdef n="def"             c="Definite"/>

    <sdef n="nom"             c="Nominative"/>
    <sdef n="acc"             c="Accusative"/>
    <sdef n="gen"             c="Genitive"/>

    <sdef n="dem"             c="Demonstrative"/>
    <sdef n="itg"             c="Question word / interrogative"/>
    <sdef n="qnt"             c="Quantifier"/>
    <sdef n="aff"             c="Affirmative" />
    <sdef n="neg"             c="Negative"/>
    <sdef n="emph"            c="Emphatic"/>

    <sdef n="inf"             c="Infinitive"/>
    <sdef n="pres"            c="Present"/>
    <sdef n="imp"             c="Imperative"/>
    <sdef n="past"            c="Past"/>
    <sdef n="fut"             c="Future" />
    <sdef n="cni"             c="Conditional" />
    <sdef n="impf"            c="Imperfective" />
    <sdef n="perf"            c="Perfect" />
    <sdef n="pros"            c="Prospective" />
    <sdef n="pp"              c="Perfect participle"/>
    <sdef n="pprs"            c="Present participle"/>
    <sdef n="pasv"            c="Passive"/>
    <sdef n="actv"            c="Active voice"/>
    <sdef n="imme"            c="Immediate"/>


    <sdef n="sint"            c="Synthetic (of adjectives)"/>
    <sdef n="pst"             c="Positive"/>
    <sdef n="comp"            c="Comparative"/>
    <sdef n="sup"             c="Superlative"/>

    <sdef n="ord"             c="Ordinal"/>
    <sdef n="acr"             c="Acronym"/>
    <sdef n="unc"             c="Uncountable"/>

    <sdef n="num"             c="Numeral"/>
    <sdef n="sent"            c="Sentence end"/>
    <sdef n="cm"              c="Comma"/>
    <sdef n="apos"            c="Apostrophe"/>
    <sdef n="guio"            c="Dash"/>
    <sdef n="lpar"            c="Left parenthesis"/>
    <sdef n="rpar"            c="Right parenthesis"/>
    <sdef n="lquot"           c="Left quote"/>
    <sdef n="rquot"           c="Right quote"/>
    <sdef n="lquest" 	c="left question mark"/> 

    <sdef n="cmp" c="compound"/>
    <sdef n="compound-only-L" c="May only be the left-side of a compound"/>
    <sdef n="compound-R"      c="May be the right-side of a compound, or a full word"/>
  </sdefs>



  <pardefs>

    <pardef n="guionet">
      <e>       <p><l>-</l>         <r>-<s n="guio"/></r></p></e>
    </pardef>

    <pardef n="coma">
      <e>       <p><l>,</l>         <r>,<s n="cm"/></r></p></e>
    </pardef>

    <pardef n="lainausmerkit">
      <e>       <p><l>&quot;</l>    <r>&quot;<s n="lquot"/></r></p></e>
      <e>       <p><l>&quot;</l>    <r>&quot;<s n="rquot"/></r></p></e>
      <e>       <p><l>”</l>         <r>&quot;<s n="rquot"/></r></p></e>
      <e>       <p><l>“</l>         <r>&quot;<s n="lquot"/></r></p></e>
      <e>       <p><l>"</l>         <r>&quot;<s n="rquot"/></r></p></e>
      <e r="LR"><p><l>»</l>         <r>&quot;<s n="rquot"/></r></p></e>
      <e r="LR"><p><l>«</l>         <r>&quot;<s n="lquot"/></r></p></e>
    </pardef>

    <pardef n="aposchar">
      <e>       <i>'</i></e>
      <e r="LR"><p><l>’</l>         <r>'</r></p></e>
    </pardef>

    <pardef n="cometa">
      <e>       <par n="aposchar"/><p><l></l><r><s n="apos"/></r></p></e>
    </pardef>

    <pardef n="separa">
      <e>       <re>[.\?;:!]+</re><p><l></l><r><s n="sent"/></r></p></e>
    </pardef>

    <pardef n="separ">
      <e>       <re>[¿¡]</re><p><l></l><r><s n="lquest"/></r></p></e>
    </pardef>

    <pardef n="paresq">
      <e>       <re>[\(\[]</re><p><l></l><r><s n="lpar"/></r></p></e>
    </pardef>

    <pardef n="pardret">
      <e>       <re>[\)\]]</re><p><l></l><r><s n="rpar"/></r></p></e>
    </pardef>

    <pardef n="emails">
      <e>       <re>[a-z.]+@[a-z.]+</re><p><l></l><r><s n="n"/></r></p></e>
    </pardef>

    <pardef n="urls">
      <e>       <re>((www.)[a-z\-]+[.][a-z]+)</re><p><l></l><r><s n="n"/></r></p></e>
    </pardef>

    <!-- Define paradigms within <pardef> here. -->
    <pardef n="numeral">
      <e><re>[0123456789]+</re></e>
    </pardef>
    <pardef n="number">
      <e><par n="numeral"/><p><l></l><r><s n="num"/></r></p></e>
    </pardef>

    <pardef n="cp-R"
            c="Add hidden tag during analysis (allowing use as final compound part),
               allow generation without the tag.">
      <e r="RL"><p><l></l>            <r></r></p></e>
      <e r="LR"><p><l></l>            <r><s n="compound-R"/></r></p></e>
    </pardef>
    
    <pardef n="cp-L"
            c="Add hidden tag for analysis as non-final compound (along with non-hidden cmp-tag),
               allow generation with non-hidden cmp-tag">
      <e r="RL"><p><l></l>            <r><s n="cmp"/></r></p></e>
      <e r="LR"><p><l></l>            <r><s n="cmp"/><s n="compound-only-L"/></r></p></e>
    </pardef>
    
    <pardef n="cp-both"
            c="For analyses that can be both non-final and final">
      <e>       <p><l></l>            <r></r></p> <par n="cp-L"/></e>
      <e>       <p><l></l>            <r></r></p> <par n="cp-R"/></e>
    </pardef>
<!--
     <pardef n="u__vbpr">

    </pardef>

-->

    <pardef n="__vblex">
      <e>       <p><l></l>          <r><s n="vblex"/></r></p><par n="cp-both"/></e>
      <e>       <p><l>ne</l>        <r><s n="vblex"/><s n="pprs"/></r></p></e>
      <e>       <p><l>do</l>        <r><s n="vblex"/><s n="pp"/></r></p></e>
    </pardef>

    <pardef n="__adj">
      <e>       <p><l></l>          <r><s n="adj"/></r></p><par n="cp-both"/></e>
    </pardef>

    <pardef n="cor__prn">
      <e>              <p><l></l>          <r><s n="det"/></r></p></e>
      <e r="RL">       <p><l>tø</l>       <r><s n="prn"/><s n="GD"/><s n="sg"/></r></p></e>
      <e r="RL">       <p><l>øtø</l>       <r><s n="prn"/><s n="GD"/><s n="pl"/></r></p></e>
      <e>              <p><l>te</l>       <r><s n="prn"/><s n="ut"/><s n="sg"/></r></p></e>
      <e>              <p><l>ete</l>      <r><s n="prn"/><s n="ut"/><s n="pl"/></r></p></e>
      <e>              <p><l>to</l>       <r><s n="prn"/><s n="nt"/><s n="sg"/></r></p></e>
      <e>              <p><l>oto</l>      <r><s n="prn"/><s n="nt"/><s n="pl"/></r></p></e>
      <e>              <p><l>su</l>       <r><s n="det"/><s n="pos"/></r></p></e>
      <e>              <p><l>pul</l>      <r>pul<s n="adj"/></r></p></e>
      <e>              <p><l>mo</l>       <r>mo<s n="adv"/></r></p></e>
      <e>              <p><l>kwanti</l>   <r>kwanti<s n="det"/></r></p></e>
      <e>              <p><l>numer</l>   <r>numer<s n="det"/></r></p></e>      
      <e>              <p><l>loka</l>   <r>loka<s n="adv"/></r></p></e>
      <e>              <p><l>watu</l>   <r>watu<s n="adv"/></r></p></e>
      <e>              <p><l>seba</l>   <r>seba<s n="adv"/></r></p></e>
      <e>              <p><l>maner</l>   <r>maner<s n="adv"/></r></p></e>
    </pardef>


    <pardef n="__n">
      <e>       <p><l></l>          <r><s n="n"/></r></p><par n="cp-both"/></e>
      <e>       <p><l>su</l>        <r><s n="n"/><j/>su<s n="pos"/></r></p><par n="cp-both"/></e>
    </pardef>



    <!-- Example noun inflection paradigm:
    <pardef n="house__n">
      <e><p><l></l><r><s n="n"/><s n="attr"/></r></p></e>
      <e><p><l></l><r><s n="n"/><s n="sg"/></r></p></e>
      <e><p><l>s</l><r><s n="n"/><s n="pl"/></r></p></e>
    </pardef>
    -->
  </pardefs>

  <section id="main" type="standard">
    <!-- Define entries within <e> here. -->
    <!-- Example entry:
    <e lm="house"><i>house</i><par n="house__n"/></e>-->
<!-- 
      <e lm="u">    <i>u</i><par n="u__vbpr"/></e>
 -->
      <e lm="ke">    <i>ke</i><par n="cor__prn"/></e>
      <e lm="hin">    <i>hin</i><par n="cor__prn"/></e>
      <e lm="den">    <i>den</i><par n="cor__prn"/></e>
      <e lm="ban">    <i>ban</i><par n="cor__prn"/></e>
      <e lm="moy">    <i>moy</i><par n="cor__prn"/></e>
      <e lm="nil">    <i>nil</i><par n="cor__prn"/></e>
      <e lm="alo">    <i>alo</i><par n="cor__prn"/></e>
      <e lm="sama">    <i>sama</i><par n="cor__prn"/></e>

      <e>       <p><l>su</l>                        <r>su<s n="pos"/></r></p></e>

      <e>       <p><l>ji</l>                        <r>ji<s n="cnjcoo"/></r></p></e>
      <e>       <p><l>or</l>                        <r>or<s n="cnjcoo"/></r></p></e>
      <e>       <p><l>mas</l>                        <r>mas<s n="cnjcoo"/></r></p></e>
      <e>       <p><l>kam</l>                        <r>kam<s n="cnjcoo"/></r></p></e>

      <e>       <p><l>ki</l>                        <r>ki<s n="cnjsub"/></r></p></e>
      <e>       <p><l>eger</l>                        <r>eger<s n="cnjsub"/></r></p></e>
      <e>       <p><l>hu</l>                        <r>hu<s n="cnjsub"/></r></p></e>

      <e>       <p><l>u</l>                        <r>u<s n="vbpr"/></r></p></e>
      <e>       <p><l>na</l>                       <r>u<s n="vbpr"/><s n="inf"/></r></p></e>
      <e>       <p><l>nun</l>                      <r>u<s n="vbpr"/><s n="pres"/></r></p></e>
      <e>       <p><l>nun nun</l>               <r>u<s n="vbpr"/><s n="pres"/><s n="impf"/></r></p></e>
      <e>       <p><l>nun le</l>                <r>u<s n="vbpr"/><s n="pres"/><s n="perf"/></r></p></e>
      <e>       <p><l>nun xa</l>                <r>u<s n="vbpr"/><s n="pres"/><s n="pros"/></r></p></e>
      <e>       <p><l>le</l>                       <r>u<s n="vbpr"/><s n="past"/></r></p></e>
      <e>       <p><l>le nun</l>                <r>u<s n="vbpr"/><s n="past"/><s n="impf"/></r></p></e>
      <e>       <p><l>le le</l>                 <r>u<s n="vbpr"/><s n="past"/><s n="perf"/></r></p></e>
      <e>       <p><l>le xa</l>                 <r>u<s n="vbpr"/><s n="past"/><s n="pros"/></r></p></e>
      <e>       <p><l>xa</l>                       <r>u<s n="vbpr"/><s n="fut"/></r></p></e>
      <e>       <p><l>xa nun</l>               <r>u<s n="vbpr"/><s n="fut"/><s n="impf"/></r></p></e>
      <e>       <p><l>xa le</l>                <r>u<s n="vbpr"/><s n="fut"/><s n="perf"/></r></p></e>
      <e>       <p><l>xa xa</l>                <r>u<s n="vbpr"/><s n="fut"/><s n="pros"/></r></p></e>
      <e>       <p><l>ger</l>                      <r>u<s n="vbpr"/><s n="cni"/></r></p></e>
      <e>       <p><l>ger nun</l>               <r>u<s n="vbpr"/><s n="cni"/><s n="impf"/></r></p></e>
      <e>       <p><l>ger le</l>                <r>u<s n="vbpr"/><s n="cni"/><s n="perf"/></r></p></e>
      <e>       <p><l>ger xa</l>                <r>u<s n="vbpr"/><s n="cni"/><s n="pros"/></r></p></e>
      <e>       <p><l>jale</l>                <r>u<s n="vbpr"/><s n="past"/><s n="imme"/></r></p></e>
      <e>       <p><l>jaxa</l>                <r>u<s n="vbpr"/><s n="fut"/><s n="imme"/></r></p></e>
      <e>       <p><l>am</l>                       <r>u<s n="vbpr"/><s n="imp"/></r></p></e>

      <e>       <p><l>u no</l>                        <r>u<s n="vbpr"/><s n="neg"/></r></p></e>
      <e>       <p><l>na no</l>                       <r>u<s n="vbpr"/><s n="inf"/><s n="neg"/></r></p></e>
      <e>       <p><l>nun no</l>                      <r>u<s n="vbpr"/><s n="pres"/><s n="neg"/></r></p></e>
      <e>       <p><l>nun nun no</l>               <r>u<s n="vbpr"/><s n="pres"/><s n="impf"/><s n="neg"/></r></p></e>
      <e>       <p><l>nun le no</l>                <r>u<s n="vbpr"/><s n="pres"/><s n="perf"/><s n="neg"/></r></p></e>
      <e>       <p><l>nun xa no</l>                <r>u<s n="vbpr"/><s n="pres"/><s n="pros"/><s n="neg"/></r></p></e>
      <e>       <p><l>le no</l>                       <r>u<s n="vbpr"/><s n="past"/><s n="neg"/></r></p></e>
      <e>       <p><l>le nun no</l>                <r>u<s n="vbpr"/><s n="past"/><s n="impf"/><s n="neg"/></r></p></e>
      <e>       <p><l>le le no</l>                 <r>u<s n="vbpr"/><s n="past"/><s n="perf"/><s n="neg"/></r></p></e>
      <e>       <p><l>le xa no</l>                 <r>u<s n="vbpr"/><s n="past"/><s n="pros"/><s n="neg"/></r></p></e>
      <e>       <p><l>xa no</l>                       <r>u<s n="vbpr"/><s n="fut"/><s n="neg"/></r></p></e>
      <e>       <p><l>xa nun no</l>               <r>u<s n="vbpr"/><s n="fut"/><s n="impf"/><s n="neg"/></r></p></e>
      <e>       <p><l>xa le no</l>                <r>u<s n="vbpr"/><s n="fut"/><s n="perf"/><s n="neg"/></r></p></e>
      <e>       <p><l>xa xa no</l>                <r>u<s n="vbpr"/><s n="fut"/><s n="pros"/><s n="neg"/></r></p></e>
      <e>       <p><l>ger no</l>                      <r>u<s n="vbpr"/><s n="cni"/><s n="neg"/></r></p></e>
      <e>       <p><l>ger nun no</l>               <r>u<s n="vbpr"/><s n="cni"/><s n="impf"/><s n="neg"/></r></p></e>
      <e>       <p><l>ger le no</l>                <r>u<s n="vbpr"/><s n="cni"/><s n="perf"/><s n="neg"/></r></p></e>
      <e>       <p><l>ger xa no</l>                <r>u<s n="vbpr"/><s n="cni"/><s n="pros"/><s n="neg"/></r></p></e>
      <e>       <p><l>am no</l>                       <r>u<s n="vbpr"/><s n="imp"/><s n="neg"/></r></p></e>

      <e>       <p><l>u si</l>                        <r>u<s n="vbpr"/><s n="aff"/></r></p></e>
      <e>       <p><l>na si</l>                       <r>u<s n="vbpr"/><s n="inf"/><s n="aff"/></r></p></e>
      <e>       <p><l>nun si</l>                      <r>u<s n="vbpr"/><s n="pres"/><s n="aff"/></r></p></e>
      <e>       <p><l>nun nun si</l>               <r>u<s n="vbpr"/><s n="pres"/><s n="impf"/><s n="aff"/></r></p></e>
      <e>       <p><l>nun le si</l>                <r>u<s n="vbpr"/><s n="pres"/><s n="perf"/><s n="aff"/></r></p></e>
      <e>       <p><l>nun xa si</l>                <r>u<s n="vbpr"/><s n="pres"/><s n="pros"/><s n="aff"/></r></p></e>
      <e>       <p><l>le si</l>                       <r>u<s n="vbpr"/><s n="past"/><s n="aff"/></r></p></e>
      <e>       <p><l>le nun si</l>                <r>u<s n="vbpr"/><s n="past"/><s n="impf"/><s n="aff"/></r></p></e>
      <e>       <p><l>le le si</l>                 <r>u<s n="vbpr"/><s n="past"/><s n="perf"/><s n="aff"/></r></p></e>
      <e>       <p><l>le xa si</l>                 <r>u<s n="vbpr"/><s n="past"/><s n="pros"/><s n="aff"/></r></p></e>
      <e>       <p><l>xa si</l>                       <r>u<s n="vbpr"/><s n="fut"/><s n="aff"/></r></p></e>
      <e>       <p><l>xa nun si</l>               <r>u<s n="vbpr"/><s n="fut"/><s n="impf"/><s n="aff"/></r></p></e>
      <e>       <p><l>xa le si</l>                <r>u<s n="vbpr"/><s n="fut"/><s n="perf"/><s n="aff"/></r></p></e>
      <e>       <p><l>xa xa si</l>                <r>u<s n="vbpr"/><s n="fut"/><s n="pros"/><s n="aff"/></r></p></e>
      <e>       <p><l>ger si</l>                      <r>u<s n="vbpr"/><s n="cni"/><s n="aff"/></r></p></e>
      <e>       <p><l>ger nun si</l>               <r>u<s n="vbpr"/><s n="cni"/><s n="impf"/><s n="aff"/></r></p></e>
      <e>       <p><l>ger le si</l>                <r>u<s n="vbpr"/><s n="cni"/><s n="perf"/><s n="aff"/></r></p></e>
      <e>       <p><l>ger xa si</l>                <r>u<s n="vbpr"/><s n="cni"/><s n="pros"/><s n="aff"/></r></p></e>
      <e>       <p><l>am si</l>                       <r>u<s n="vbpr"/><s n="imp"/><s n="aff"/></r></p></e>




    <e>                      <p><l>mi</l>        <r>prpers<s n="prn"/><s n="p1"/><s n="ut"/><s n="sg"/></r></p></e>
    <e>                      <p><l>manmi</l>        <r>prpers<s n="prn"/><s n="p1"/><s n="m"/><s n="sg"/></r></p></e>
    <e>                      <p><l>femmi</l>        <r>prpers<s n="prn"/><s n="p1"/><s n="f"/><s n="sg"/></r></p></e>
    <e>                      <p><l>yu</l>        <r>prpers<s n="prn"/><s n="p2"/><s n="ut"/><s n="sg"/></r></p></e>
    <e>                      <p><l>manyu</l>        <r>prpers<s n="prn"/><s n="p2"/><s n="m"/><s n="sg"/></r></p></e>
    <e>                      <p><l>femyu</l>        <r>prpers<s n="prn"/><s n="p2"/><s n="f"/><s n="sg"/></r></p></e>
