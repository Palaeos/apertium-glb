# Firstly, we need to define what tags should be considered sentence delimiters. For this example, only full stop is set as delimiter.
DELIMITERS = "<.>" ;

# We can define sets for common tag clusters
# LIST Case = (n s) (n p) ; # A set that matches either a Noun Singular or a Noun Plural
LIST Nom = n prn ; # A set that matches either a Noun or a Pronoun
LIST v = vblex vbser ; # A set that matches either a lexical verb or a copula

SECTION
# If there is a singular noun to the right, I cannot be a verb or noun.
# REMOVE (n) OR (v) IF (1 (n s)) ;


REMOVE (vblex) IF (-1 (pr))  ;
REMOVE (vblex) IF (-1 (vblex))  ;
REMOVE (vblex) IF (-1 (cnjsub)) (NOT 0 (vblex pprs)) (NOT 0 (vblex pp));
REMOVE (vblex) IF (-1 (det)) (NOT 0 (vblex pprs)) (NOT 0 (vblex pp));
REMOVE (vblex) IF (-1 (adj)) ;
REMOVE (vblex) IF (-1 (vblex pprs));
REMOVE (vblex) IF (-1 (vblex pp));
REMOVE (vblex) IF (-1 (adj)) (NOT 0 (vblex pprs)) (NOT 0 (vblex pp));
REMOVE (n) IF (-1 Nom);
SELECT (vblex) IF (-1 (adv));
REMOVE (n) IF (-1 (vbpr));
REMOVE (n) IF (1 (cnjsub));
SELECT (adj) IF (-1 (vblex))  (NOT-1 (vblex pprs)) (NOT-1 (vblex pp));
SELECT (adj) IF (-1 (pr));
SELECT (adj) IF (-1 (cnjsub));
SELECT (adj) IF (-1 (adj));
SELECT (adj) IF (-1 (vblex pprs));
SELECT (adj) IF (-1 (vblex pp));
SELECT (vbmod) IF (1 (vbpr)) ;
SELECT (adv) IF (-1 Nom);
SELECT (adv) IF (-1 (vbpr));
SELECT (adv) IF (-1 (adv)) ;


# If there is a conjunction followed by a certain cohort of the same CASE as me, choose me.
# SELECT $$Case IF (1 (cnjcoo) LINK 1C $$Case) ;

